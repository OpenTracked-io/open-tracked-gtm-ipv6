___SANDBOXED_JS_FOR_SERVER___

const getEventData = require('getEventData');
const makeInteger = require('makeInteger');
const Math = require('Math');

const HEX = '0123456789abcdef';

function hex2(n) {
  return HEX.charAt(Math.floor(n / 16)) + HEX.charAt(n % 16);
}

const ip = getEventData(data.eventDataKey || 'ip_override');
if (!ip || ip === '') {
  return undefined;
}

// already IPv6 (written in full, shortened or mapped): keep it as it is
if (ip.indexOf(':') > -1) {
  return ip;
}

// IPv4: four numbers from 0 to 255, written as the IPv6 address Meta likes
const parts = ip.split('.');
if (parts.length !== 4) {
  return ip;
}
const n = [];
for (let i = 0; i < 4; i++) {
  const v = makeInteger(parts[i]);
  if (v === undefined || v === null || v < 0 || v > 255 || parts[i] === '') {
    return ip;
  }
  n.push(v);
}
return '0000:0000:0000:0000:0000:ffff:' + hex2(n[0]) + hex2(n[1]) + ':' + hex2(n[2]) + hex2(n[3]);


